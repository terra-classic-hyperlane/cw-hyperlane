# ── Runtime state files (contain live addresses, never commit) ────────────
.warp-sealevel-state.json
.warp-solana-buffer-state.json

# ── Log files (may contain API keys, tx hashes, local paths) ─────────────
log/

# ── Duplicate / backup scripts ────────────────────────────────────────────
*copy*.sh
* copy*.sh

# ── Local keypair references (never store private keys in repo) ───────────
*.local.json

# ── Private keypairs + deployment artifacts (never commit) ────────────────
**/keys/
warp/reference-program/
warp/solanamainnet/
warp/solanatestnet/
warp/solanadevnet/
warp/terraclassic-cw20-*.json
*.bak

# ── Chaves privadas locais (NUNCA subir) ──────────────────────────────────
.tc-warp-key.sh
*key*.env
*.key
.env
.env.*

# ── State/backup files do deploy EVM (endereços/estado local) ─────────────
.warp-evm-state.json
warp-evm-config.json.bak*
